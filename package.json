{
  "name": "klassikerplaneraren",
  "private": true,
  "version": "1.0.0-beta",
  "description": "Genererar ett personligt träningsprogram för En svensk klassiker.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
